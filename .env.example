# ==============================================================================
# Autonomous AI Engineering Office — Environment Configuration Example
# Copy this file to .env (or ~/.engineering-office/.env) to configure API keys.
# Never commit real credentials to version control.
# ==============================================================================

# --- Cloud Model Escalation (Zero-Cost / Free-Tier Providers) ---
# OpenRouter API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional: Specify an OpenRouter model (default dynamically negotiates active :free tier models)
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Google Gemini API Key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: Specify Gemini model
# GEMINI_MODEL=gemini-2.5-flash

# Groq Cloud API Key (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
# Optional: Specify Groq model
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Privacy & Zero-Cost Guardrails ---
# Ensure no charges can be incurred by capping max cloud spend to $0.00
MAX_CLOUD_COST_USD=0
ZERO_COST_ONLY=true

# Privacy mode for source code:
# - sanitized-evidence-only: Only compact, redacted problem dossiers and test outputs leave the machine.
# - local-only: Completely disables cloud escalation, keeping everything on local models / deterministic tools.
OFFICE_CLOUD_PRIVACY_MODE=sanitized-evidence-only

# Allow bounded, sanitized snippets for cloud escalation when no local model is available (0 or 1)
OFFICE_ALLOW_CLOUD_SOURCE_SNIPPETS=0

# Allow unverified free-tier models (default: false, requiring explicit zero-cost catalog verification)
OFFICE_ALLOW_UNVERIFIED_FREE_TIER=false
